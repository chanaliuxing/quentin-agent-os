{
  "max_iterations": 5,
  "sleep_seconds": 5.0,
  "session_id": "latest",
  "verify_command": "QUENTIN_VERIFY_STRESS=0 python3 verify_system.py",
  "test_command": "pytest -q tests/unit/test_verify_system_env_contract.py",
  "analyzer_command": "gemini -p {prompt}",
  "fixer_command": "gemini -p {prompt}",
  "analyzer_timeout_s": 420,
  "fixer_timeout_s": 1200,
  "verify_timeout_s": 3600,
  "test_timeout_s": 600,
  "stop_on_token_exhausted": true,
  "max_log_lines_per_file": 400,
  "log_files": [
    "data/traces/events.jsonl.gz",
    "data/audit_events.jsonl",
    "data/llm_raw_history.jsonl"
  ],
  "run_root": "generated/brain_autoloop",
  "analyzer_prompt_template": "prompts/autoloop/analyzer.md",
  "fixer_prompt_template": "prompts/autoloop/fixer.md",
  "fixer_expect_json": true,
  "require_file_changes": true,
  "stop_on_no_file_change": true,
  "allowed_write_roots": [
    "extensions/tools",
    "mutable",
    "generated",
    "tests",
    "scripts",
    "meta_agent",
    "quentin",
    "docs",
    "config",
    "verify_system.py"
  ],
  "max_changes_per_iteration": 20,
  "require_benchmark_improve": false,
  "iteration_cleanup_paths": [
    "extensions/tools/xh_leads",
    "mutable/xh_leads.csv"
  ],
  "env_overrides": {
    "CODER_BACKEND": "gemini_cli",
    "PYTHONPATH": "."
  }
}
