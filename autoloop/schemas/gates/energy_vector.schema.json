{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoloop/schemas/gates/energy_vector.schema.json",
  "title": "EnergyVector",
  "type": "object",
  "required": [
    "energy_id",
    "run_id",
    "phase_id",
    "module_id",
    "weighted_score",
    "hard_fail",
    "failing_invariants",
    "gate_results",
    "blame_candidates",
    "recommended_action"
  ],
  "additionalProperties": false,
  "properties": {
    "energy_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "phase_id": {
      "type": "string",
      "minLength": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "weighted_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "hard_fail": {
      "type": "boolean"
    },
    "failing_invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gate_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GateResult"
      }
    },
    "blame_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BlameCandidate"
      }
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "advance",
        "retry_module",
        "diagnose",
        "rollback_phase",
        "halt"
      ]
    }
  },
  "$defs": {
    "GateResult": {
      "type": "object",
      "required": [
        "gate_name",
        "status",
        "score"
      ],
      "additionalProperties": false,
      "properties": {
        "gate_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "BlameCandidate": {
      "type": "object",
      "required": [
        "layer",
        "target_id",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "layer": {
          "type": "string",
          "enum": [
            "sor",
            "tasking",
            "implementation",
            "tests",
            "workflow"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
