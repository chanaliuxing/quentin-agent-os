{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoloop/schemas/contracts/acceptance_spec.schema.json",
  "title": "AcceptanceSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "acceptance_id",
    "task_id",
    "required_tests",
    "required_graders",
    "required_artifacts",
    "hidden_test_group",
    "rollback_on_failure",
    "human_review_required"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "required_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_graders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden_test_group": {
      "type": "string",
      "minLength": 1
    },
    "rollback_on_failure": {
      "type": "boolean"
    },
    "human_review_required": {
      "type": "boolean"
    }
  }
}
