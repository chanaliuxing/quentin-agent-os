{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoloop/schemas/contracts/task_spec.schema.json",
  "title": "TaskSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "project_id",
    "phase_id",
    "module_id",
    "requirement_ids",
    "workspace_id",
    "repo_root",
    "worktree_path",
    "base_sha",
    "head_sha",
    "input_artifacts",
    "output_artifacts",
    "priority",
    "risk_level"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "phase_id": {
      "type": "string",
      "minLength": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "worktree_path": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string"
    },
    "head_sha": {
      "type": "string"
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "minLength": 1
    }
  }
}
